# Development configuration for gateway-api and orders-api.
# Docker Compose reads .env automatically; Spring Boot requires exported variables.
# Generate your own secret: openssl rand -base64 32
# JWT_SECRET must be Base64 encoding of at least 32 random bytes. No default secret.
JWT_SECRET=
JWT_ISSUER=gateway-api

# Fictitious development credentials. Compose creates two isolated PostgreSQL services.
GATEWAY_DB_URL=jdbc:postgresql://localhost:5432/gateway_db
GATEWAY_DB_USERNAME=gateway_dev
GATEWAY_DB_PASSWORD=gateway_dev
GATEWAY_DDL_AUTO=update
# Enable the known test account only in local development / the assessment.
GATEWAY_SEED_TEST_USER=true
# Comma-separated exact browser origins; no wildcards or trailing slash.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
ORDERS_API_URL=http://localhost:8081
ORDERS_API_CONNECT_TIMEOUT=2s
ORDERS_API_TIMEOUT=5s

# Orders validates tokens with the same JWT_SECRET and JWT_ISSUER above.
ORDERS_DB_URL=jdbc:postgresql://localhost:5433/orders_db
ORDERS_DB_USERNAME=orders_dev
ORDERS_DB_PASSWORD=orders_dev
ORDERS_DDL_AUTO=update
# Local-only by default. Containers require 0.0.0.0 on a private network without a published Orders port.
ORDERS_SERVER_ADDRESS=127.0.0.1

# Ports published by Compose; both databases bind only to loopback.
GATEWAY_DB_PORT=5432
ORDERS_DB_PORT=5433
GATEWAY_API_PORT=8080
GATEWAY_BIND_ADDRESS=127.0.0.1
# Compose overrides JDBC URLs, ORDERS_API_URL and ORDERS_SERVER_ADDRESS internally.
# For access from other machines set GATEWAY_BIND_ADDRESS=0.0.0.0;
# configure the browser origin separately using GATEWAY_CORS_ALLOWED_ORIGINS.
